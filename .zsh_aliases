if type bat > /dev/null;then
    alias cat='bat'
    PREVIEW_COMMAND="bat --color=always"
fi

if type gsed > /dev/null;then
    alias sed='gsed'
fi

if type gxargs > /dev/null;then
    alias xargs='gxargs'
fi

if type lsd > /dev/null;then
    alias ls='lsd'
elif ls --version 2> /dev/null | grep GNU &> /dev/null;then
    alias ls='ls --color=auto'
    eval `dircolors -b`
else
    alias ls='ls -G'
fi

alias repos='ghq list -p --vcs=git | fzf --preview "'"${PREVIEW_COMMAND}"' {}/README.md"'

gip() {
  opt=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -4) opt="-4" ;;
      -6) opt="-6" ;;
      -h|--help)
        echo "Usage: gip [-4|-6]  (-4=IPv4, -6=IPv6, no option=auto v6→v4)"
        return
        ;;
      *)
        echo "gip: unknown option: $1"
        return 1
        ;;
    esac
    shift
  done

  if [ -n "$opt" ]; then
    curl -s $opt icanhazip.com
  else
    curl -s -6 icanhazip.com || curl -s -4 icanhazip.com
  fi
}

case ${OSTYPE} in
    darwin*) 
        BROWSER='/Applications/Google Chrome.app'
        if [ -f "${BROWSER}" ]
            alias browse='open -a '\'"${BROWSER}"\'
        ;;
esac

alias whois='whois -h whois.cymru.com'

access_per_minute(){
    local mode=""
    local dir="apache2/domlogs"
    local OPTIND=1
    while getopts "p:d" opt; do
        case "$opt" in
            p)
                mode="$OPTARG"
                ;;
            d)
                dir="$OPTARG"
                ;;
            *)
                echo "Usage: my_func [-p minute|ua] [-d directory] [host]"
                return 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    local host=$1
    _per_minute() { awk '{print $4}' | cut -b2-18 | sort | uniq -c; }
    _per_ua()     { awk -F'"' '{print $6}' | sort | uniq -c | sort -nr;}
    _per_path()     { awk '{print $7}' | sort | uniq -c | sort -nr;}
    case "$mode" in
        "minute")
            echo "モード: 分単位 / ディレクトリ: $dir"
            ;;
        "ua")
            echo "モード: User-Agent / ディレクトリ: $dir"
            ;;
        *)
            echo "エラー: -p オプションで minute または ua を指定してください。"
            return 1
            ;;
    esac
    ssh $host grep -r -e "$(date '+%d/%b/%Y:%H')" /var/log/"${web}" | awk '{print $4}' | cut -b2-18 | sort | uniq -c
}
access_per_ua(){

}
alias access_per_minute="grep -r $(date '+%d/%b/%Y:%H') | awk '{print $4}' | cut -b2-18 | sort | uniq -c"
alias grep_dynamic='grep -ive "GET /.*\.\(css.*\|js.*\|jpeg.*\|svg.*\|webp.*\|jpg.*\|gif.*\|png.*\|swf\|ico\)\ HTTP"'
